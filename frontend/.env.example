# En desarrollo las peticiones a /api y /auth se proxean al backend
# (ver vite.config.js), así que no hace falta VITE_API_URL.
#
# VITE_API_URL sí se usa si el frontend se despliega en otro origen
# (p. ej. Vercel apuntando a la API en Render). En ese caso el backend
# debe autorizar este origen en CORS_ALLOWED_ORIGINS y usar
# AUTH_COOKIE_SAMESITE=None; ver backend/README.md. El token CSRF viaja
# en el cuerpo de /auth/csrf/, login y refresh, de modo que no hace falta
# leer cookies del dominio de la API.

VITE_API_URL=""