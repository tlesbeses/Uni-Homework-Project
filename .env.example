# Variables de podman-compose (interpolacion ${...} del podman-compose.yml).
# Copiar a .env y ajustar. Nunca commitear .env.
#
#   cp .env.example .env

# Requerida por settings.py. Si falta, el compose usa el default inseguro
# "edunotas-dev-insecure-no-usar-en-produccion". Generar una real con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Password del superusuario que crea `manage.py createadmin` (usuario admin).
# Default en el compose: admin.
ADMIN_PASSWORD=admin
