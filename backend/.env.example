# Django settings loaded via python-dotenv (see config/settings.py).
# Copy this file to .env and fill in real values. Never commit .env.

# Required in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Keep False in production (it is the default). Set True only for local dev.
DEBUG=False

# Comma-separated list. Must include the Render hostname, otherwise requests
# fail with DisallowedHost.
ALLOWED_HOSTS=localhost,127.0.0.1,uni-homework-project.onrender.com

# Optional. Defaults to the local SQLite file when unset.
DATABASE_URL=sqlite:///db.sqlite3
