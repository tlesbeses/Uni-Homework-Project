# Django settings loaded via python-dotenv (see config/settings.py).
# Copy this file to .env and fill in real values. Never commit .env.

# Required in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Keep False in production (it is the default). Set True only for local dev.
DEBUG=False

# Feature flag del panel de administración (default True). Cuando es False, el
# backend responde 403 a todas las APIs admin (aunque el usuario sea superuser)
# y el frontend oculta el acceso al panel.
# ADMIN_PANEL_ENABLED=True

# Comma-separated list. Must include the Render hostname, otherwise requests
# fail with DisallowedHost.
ALLOWED_HOSTS=localhost,127.0.0.1,uni-homework-project.onrender.com

# Optional. Defaults to the local SQLite file when unset.
DATABASE_URL=sqlite:///db.sqlite3

# Comma-separated frontend origins allowed to call the API with credentials
# (CORS). Only needed when the frontend is served from a different origin;
# the defaults cover the local Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SameSite policy for auth cookies: Lax (default), Strict or None.
# Keep Lax/Strict when the SPA is served by Django itself. Set None only
# when frontend and API live on different sites; cookies then force Secure.
AUTH_COOKIE_SAMESITE=Lax

# Comma-separated trusted origins for CSRF validation.
# Defaults to localhost + the Render hostname when unset.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://uni-homework-project.onrender.com

# Content-Security-Policy in blocking mode. Defaults to True: emits the
# Content-Security-Policy header that enforces the policy (only in non-DEBUG).
# Set CSP_APPLY=False only if the built frontend violates the policy.
# CSP_APPLY=True

# Optional. CSP reporting endpoint URI. When set, additionally emits
# Content-Security-Policy-Report-Only with the same policy, so violations are
# reported without breaking anything.
# CSP_REPORT_URI=https://your-csp-endpoint.example.com/report

# Optional. Redis URL for production caching. When unset, Django uses
# LocMemCache (in-memory, per-process). Set this when you add a Redis
# service on Render (Upstash, Redis Labs, etc.) to get cross-worker cache
# and better performance under load.
# REDIS_URL=redis://:password@host:6379/0

# Envío de correo (activación de cuenta y recuperación de contraseña).
# El PROVEEDOR ACTIVO se elige en código, con UNA línea en
# backend/config/email_config.py:
#   from config.providers.brevo import *   # REST API de Brevo (HTTPS/443)
#   from config.providers.gmail import *   # Gmail SMTP (smtp.gmail.com:587)
# Cada proveedor (config/providers/*.py) lleva fija TODA su configuración
# (host, puerto, TLS, backend y el fallback a "console" sin credenciales).
# Acá solo se completa LA CREDENCIAL del proveedor activo. Sin credenciales
# se usa el backend "console" (cada correo se imprime en la terminal).

# --- Si el proveedor activo es Brevo (producción recomendada) ---
# Render free bloquea SMTP saliente (25/465/587) desde sept/2025; la API de
# Brevo viaja por HTTPS (443), que nunca se bloquea.
# 1) Cuenta Brevo gratis (login.brevo.com) -> 300 correos/día.
# 2) Config. de la empresa > Remitentes: agregá pevin.kevin@gmail.com y
#    verificá la propiedad con el link que llega a ese correo.
# 3) SMTP & API > Claves de API > Generar clave de API v3.
# 4) Esta única variable (en .env local y en Render):
BREVO_API_KEY=

# 5) En Brevo: Security > Authorized IPs, usar "autorización automática" (o
#    dejar el bloqueo de IPs desactivado). NO autorizar una IP puntual: Render
#    free usa IPs de salida dinámicas/compartidas por región, y cuando la IP
#    rote el envío volverá a fallar con "Unauthorized: IP not authorized".

# --- Si el proveedor activo es Gmail usualmente (dev/SMTP habilitado) ---
# Genera la app password en Google (Verificación en 2 pasos):
#   Cuenta de Google → Seguridad → Verificación en 2 pasos →
#   Contraseñas de aplicación → "Correo" en el dispositivo. Pega aquí el
#   código de 16 caracteres resultante (sin espacios).
EMAIL_HOST_USER=tu.cuenta@gmail.com
EMAIL_HOST_PASSWORD=

# Remitente por defecto (opcional). Gmail: la dirección debe ser la cuenta
# que se autentica (EMAIL_HOST_USER). Brevo: la dirección que verificaste en
# el proveedor. Por defecto: "EduNotas <EMAIL_HOST_USER>" (Gmail) o
# "EduNotas <pevin.kevin@gmail.com>" (Brevo, ver config/providers/brevo.py).
# DEFAULT_FROM_EMAIL=EduNotas <tu.cuenta@gmail.com>

# Si False, los usuarios registrados nacen activos (sin verificación de
# email). Por defecto True: el registro exige activar la cuenta desde el
# correo antes de poder iniciar sesión.
# REQUIRE_EMAIL_VERIFICATION=True

# Dominio/protocolo con el que Djoser arma los links de activación y de reset
# de contraseña dentro de los correos. Default: localhost:8000/HTTP en
# desarrollo y https://uni-homework-project.onrender.com/HTTPS en producción
# (se deriva de DEBUG). Solo hace falta definirlos si el despliegue usa un
# dominio propio.
# DJOSER_DOMAIN=uni-homework-project.onrender.com
# DJOSER_PROTOCOL=https
# DJOSER_SITE_NAME=EduNotas
